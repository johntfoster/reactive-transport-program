{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "directory",
          "manifest",
          "repository",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
